---
import { businessName, phoneDisplay, phoneTel } from '../config/site.ts';

export interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { name: 'Services', href: '/concrete-leveling/' },
  { name: 'Polyjacking', href: '/concrete-leveling/polyurethane-foam-lifting/' },
  { name: 'Before & After', href: '/before-and-after/' },
  { name: 'Service Areas', href: '/service-areas/' },
  { name: 'Pricing & Cost', href: '/concrete-leveling-cost/' },
  { name: 'Guides', href: '/guides/' },
  { name: 'Contact', href: '/contact/' },
];

function isCurrent(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand-link" aria-label={`${businessName} Home`}>
      {businessName}
    </a>

    <button
      type="button"
      class="mobile-menu-toggle"
      aria-expanded="false"
      aria-controls="primary-navigation"
    >
      Menu
    </button>

    <nav id="primary-navigation" class="site-nav" aria-label="Primary Navigation">
      <ul class="nav-list">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav-link"
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.name}
            </a>
          </li>
        ))}
      </ul>

      <div class="header-phone">
        <span class="header-phone-label">Call For Free Quote</span>
        <a href={phoneTel} class="header-phone-number">
          {phoneDisplay}
        </a>
      </div>
    </nav>
  </div>
</header>
