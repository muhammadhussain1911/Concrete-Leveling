---
// Hero diagram inline SVG cross-section showing slab, void, injection hole and lifted slab.
// Flat fills only. No <title> inside inline SVG; uses aria-label.
---

<div class="hero-diagram-wrap">
  <svg
    viewBox="0 0 600 380"
    width="600"
    height="380"
    role="img"
    aria-label="Cross section diagram illustrating polyurethane foam concrete lifting under a settled slab"
    xmlns="http://www.w3.org/2000/svg"
  >
    <!-- Background Frame -->
    <rect width="600" height="380" fill="#FAF8F5" />
    
    <!-- Subgrade Soil Base (Bottom Layer) -->
    <rect x="20" y="270" width="560" height="90" fill="#DDD8CF" />
    <text x="36" y="325" font-family="Public Sans, sans-serif" font-size="13" font-weight="600" fill="#4F565D">
      Compacted Subgrade Soil Stratum
    </text>

    <!-- Eroded Soil Void Under Slab -->
    <path d="M 20 270 Q 180 270 240 250 Q 300 230 420 250 Q 500 265 580 270 L 580 200 L 20 200 Z" fill="#CFCAC1" />

    <!-- Expanding High-Density Polyurethane Foam Zone (Flat Accent Fill) -->
    <path d="M 120 270 Q 220 260 280 240 Q 340 220 440 240 Q 480 250 510 270 L 510 170 L 120 170 Z" fill="#C2410C" />

    <!-- Foam Expansion Cellular Texture Indicator Lines (Flat) -->
    <line x1="260" y1="210" x2="260" y2="180" stroke="#FFFFFF" stroke-width="2" />
    <line x1="330" y1="220" x2="330" y2="180" stroke="#FFFFFF" stroke-width="2" />
    <line x1="390" y1="230" x2="390" y2="180" stroke="#FFFFFF" stroke-width="2" />
    <!-- Upward Force Arrowheads -->
    <polygon points="260,174 254,184 266,184" fill="#FFFFFF" />
    <polygon points="330,174 324,184 336,184" fill="#FFFFFF" />
    <polygon points="390,174 384,184 396,184" fill="#FFFFFF" />

    <!-- Unlifted / Original Sunken Slab Outline (Ghost Line) -->
    <polygon points="20,200 580,200 580,240 20,240" fill="none" stroke="#CFCAC1" stroke-width="1.5" stroke-dasharray="4,4" />
    <text x="36" y="225" font-family="Public Sans, sans-serif" font-size="12" fill="#4F565D">
      Prior Sunken Position (-2.5 in.)
    </text>

    <!-- Restored Level Concrete Slab (Solid Top Layer) -->
    <polygon points="20,130 580,130 580,170 20,170" fill="#FFFFFF" stroke="#1B1F23" stroke-width="2" />
    <text x="36" y="155" font-family="Public Sans, sans-serif" font-size="14" font-weight="600" fill="#1B1F23">
      Solid Concrete Slab (4 in. Standard Pavement)
    </text>

    <!-- 5/8" Injection Port / Hole (Dime-Sized) -->
    <rect x="323" y="130" width="14" height="40" fill="#1B1F23" />
    <line x1="330" y1="80" x2="330" y2="125" stroke="#1B1F23" stroke-width="1.5" />
    <circle cx="330" cy="125" r="3" fill="#1B1F23" />
    
    <!-- Injection Port Annotation Callout -->
    <rect x="240" y="45" width="180" height="34" fill="#FFFFFF" stroke="#1B1F23" stroke-width="1.5" rx="3" />
    <text x="250" y="67" font-family="Public Sans, sans-serif" font-size="12" font-weight="600" fill="#1B1F23">
      5/8-inch Drill Hole (Penny/Dime)
    </text>

    <!-- Poly Foam Lifting Expansion Callout -->
    <rect x="230" y="285" width="200" height="34" fill="#FFFFFF" stroke="#1B1F23" stroke-width="1.5" rx="3" />
    <text x="240" y="307" font-family="Public Sans, sans-serif" font-size="12" font-weight="600" fill="#C2410C">
      High-Density Expanding Poly Foam
    </text>
    <line x1="330" y1="285" x2="330" y2="245" stroke="#1B1F23" stroke-width="1.5" />
    <circle cx="330" cy="245" r="3" fill="#1B1F23" />

    <!-- Level Alignment Reference Line -->
    <line x1="10" y1="130" x2="590" y2="130" stroke="#C2410C" stroke-width="1.5" stroke-dasharray="6,4" />
    <text x="445" y="122" font-family="Public Sans, sans-serif" font-size="11" font-weight="600" fill="#C2410C">
      Laser Level Grade Line
    </text>
  </svg>
</div>
