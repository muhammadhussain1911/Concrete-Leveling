---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  businessName,
  city,
  state,
  phoneDisplay,
  phoneTel,
  email,
  licenseNumber,
  insured,
  warrantyText,
  yearsInBusiness,
  streetAddress,
  gbpUrl,
  domain,
} from '../config/site.ts';

const pageTitle = `About ${businessName} | Concrete Leveling in ${city}`;
const pageDescription = `Learn about ${businessName}. Professional polyurethane foam concrete leveling and polyjacking contractors serving ${city}, ${state}. Call today.`;

const breadcrumbs = [{ name: 'About Us', path: '/about/' }];

import { getAboutPageSchema } from '../utils/schema.ts';

const schemas = [getAboutPageSchema()];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/about/"
  breadcrumbs={breadcrumbs}
  schemas={schemas}
>
  <div class="container" style="padding-top: 32px; padding-bottom: 32px;">
    <h1>About {businessName}</h1>
    <p class="lead">
      Specialized polyurethane foam concrete lifting contractors dedicated to precision slab restoration, subgrade stabilization, and honest trade pricing across {city}, {state}.
    </p>
  </div>

  <section class="section bg-surface" style="padding-top: 0;">
    <div class="container">
      <div class="content-grid">
        <div class="content-main">
          <h2>Our Philosophy: Save the Slab, Fix the Subgrade</h2>
          <p>
            At {businessName}, we believe that tearing out structurally sound concrete is a wasteful, expensive mistake. In the vast majority of cases where driveways drop, front sidewalks trip pedestrians, or patios tilt backward, the concrete itself is perfectly fine. The failure lies in the soil subgrade beneath it.
          </p>
          <p>
            Our company was founded to provide homeowners and commercial property managers throughout {city} and surrounding townships with a modern, non-destructive alternative to traditional concrete replacement and messy mudjacking. We operate state-of-the-art mobile proportioning rigs equipped with heated chemical delivery systems and optical laser transit sensors.
          </p>
          <p>
            By using high-density, closed-cell polyurethane foam, we raise sunken flatwork through dime-sized 5/8-inch holes. Our process cures in 15 to 30 minutes, adds virtually no weight to fragile central Ohio soils, and leaves lawns and landscaping completely undisturbed.
          </p>

          <h2>Tradesperson Integrity: What Sets Our Crew Apart</h2>
          <p>
            We operate as tradespeople, not high-pressure salespeople. When you contact our office, you speak directly with experienced concrete restoration technicians who understand soil compaction, hydraulic lift physics, and concrete tensile limits.
          </p>
          <ul>
            <li style="margin-bottom: 14px;">
              <strong>Honest Site Assessments:</strong> We tell you the truth about your concrete. If a slab is too pulverized, spalled, or cracked to lift safely, we will tell you directly rather than taking your money for a temporary fix.
            </li>
            <li style="margin-bottom: 14px;">
              <strong>Root-Cause Diagnosis:</strong> Lifting a slab without fixing downspout washouts or buried pipe leaks is only half the job. We evaluate site drainage on every inspection so you can prevent future soil erosion.
            </li>
            <li style="margin-bottom: 14px;">
              <strong>Fixed-Price Written Quotes:</strong> We calculate void volume and elevation requirements using optical laser levels. Our written proposals are clear and itemized, with no hidden disposal surcharges or unexpected add-ons.
            </li>
            <li style="margin-bottom: 14px;">
              <strong>Clean Job Sites:</strong> We drill small 5/8-inch holes, vacuum concrete dust immediately, and seal all ports with color-matched polymer mortar. When our crew leaves, your property is clean and ready for immediate use.
            </li>
          </ul>

          <h2>Our Advanced Equipment Fleet & Rig Specifications</h2>
          <p>
            Unlike general handyworkers who attempt concrete lifting using entry-level spray foam tanks, {businessName} deploys custom-built, climate-controlled mobile proportioning rigs. Each rig houses high-pressure hydraulic proportioners capable of delivering two-component closed-cell polymer at precise temperatures between 120°F and 140°F under 1,500 to 2,000 PSI impingement pressures.
          </p>
          <p>
            Our crews carry up to 250 feet of heated chemical supply line, allowing our heavy trailers to remain parked on the municipal street curb. We never drive heavy machinery across your manicured turf, crush delicate irrigation sprinkler lines, or disturb private landscape beds. Everything needed for subgrade injection passes through a single flexible, lightweight line.
          </p>

          <h2>Environmental Stewardship & Material Safety</h2>
          <p>
            We are deeply committed to protecting Central Ohio's soil, watershed, and residential green spaces. Our structural polyurethane formulations are engineered specifically for below-grade geotechnical applications:
          </p>
          <ul>
            <li style="margin-bottom: 8px;">
              <strong>Zero Leaching:</strong> Once cured (in less than 15 minutes), our closed-cell polymers are completely inert and will not leach chemicals into surrounding topsoil, groundwater tables, or nearby garden beds.
            </li>
            <li style="margin-bottom: 8px;">
              <strong>Eco-Friendly Blowing Agents:</strong> We utilize modern hydrofluoroolefin (HFO) blowing agent technology that possesses zero ozone depletion potential (ODP) and an ultra-low global warming potential (GWP &lt; 1).
            </li>
            <li style="margin-bottom: 8px;">
              <strong>Landfill Waste Diversion:</strong> Demolishing and replacing a typical 3-car concrete driveway sends roughly 25 to 40 tons of concrete rubble to local landfills. Polyjacking preserves your existing concrete in place, eliminating demolition debris entirely.
            </li>
          </ul>

          <h2>Company Credentials & Field Standards</h2>
          <div style="background-color: var(--bg); border: 1px solid var(--hairline); padding: 24px; border-radius: 4px; margin-top: 24px; margin-bottom: 32px;">
            <ul style="list-style: none; display: flex; flex-direction: column; gap: 10px;">
              <li><strong>Business Name:</strong> {businessName}</li>
              <li><strong>Headquarters / Service Metro:</strong> {city}, {state}</li>
              <li><strong>Dispatch Telephone:</strong> <a href={phoneTel} class="phone-link">{phoneDisplay}</a></li>
              <li><strong>Direct Email:</strong> <a href={`mailto:${email}`}>{email}</a></li>
              {yearsInBusiness && <li><strong>Experience:</strong> {yearsInBusiness} Years Local Field Service</li>}
              {licenseNumber && <li><strong>Contractor License:</strong> {licenseNumber}</li>}
              {insured && <li><strong>Insurance Coverage:</strong> Fully Licensed & Insured ($1M+ General Liability)</li>}
              {warrantyText && <li><strong>Residential Warranty:</strong> {warrantyText}</li>}
              {streetAddress && <li><strong>Physical Shop:</strong> {streetAddress}</li>}
              {gbpUrl && (
                <li>
                  <strong>Google Profile:</strong> <a href={gbpUrl} target="_blank" rel="noopener noreferrer">View Google Business Profile</a>
                </li>
              )}
            </ul>
          </div>

          <h2>Explore Our Services and Technical Guides</h2>
          <p>
            Learn more about our specific concrete leveling applications and technical research:
          </p>
          <ul>
            <li style="margin-bottom: 8px;">
              <a href="/concrete-leveling/">Concrete Leveling Services Directory</a>
            </li>
            <li style="margin-bottom: 8px;">
              <a href="/concrete-leveling/polyurethane-foam-lifting/">Polyurethane Foam Lifting Technical Specs</a>
            </li>
            <li style="margin-bottom: 8px;">
              <a href="/concrete-leveling-cost/">Concrete Leveling Cost & Pricing Guide</a>
            </li>
            <li style="margin-bottom: 8px;">
              <a href="/service-areas/">Central Ohio Service Area Directory</a>
            </li>
            <li style="margin-bottom: 8px;">
              <a href="/contact/">Request a Free On-Site Inspection</a>
            </li>
          </ul>
        </div>

        <aside class="sidebar-box">
          <h3>Request an Inspection</h3>
          <p class="text-secondary" style="font-size: 15px;">
            Connect with our {city} estimating team for an on-site evaluation:
          </p>
          <a href="/contact/" class="btn-primary" style="width: 100%; margin-top: 16px;">
            Get Free Quote
          </a>
          <p style="text-align: center; margin-top: 16px; margin-bottom: 0;">
            Direct phone: <a href={phoneTel} class="phone-link">{phoneDisplay}</a>
          </p>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
