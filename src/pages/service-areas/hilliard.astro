---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EstimateForm from '../../components/EstimateForm.astro';
import {
  businessName,
  state,
  phoneDisplay,
  phoneTel,
  domain,
  warrantyText,
  licenseNumber,
} from '../../config/site.ts';

const townName = 'Hilliard';
const townCounty = 'Franklin County';

const pageTitle = `Concrete Leveling Hilliard, OH | Poly Foam Lifting`;
const pageDescription = `Precision concrete leveling in Hilliard, OH. Lift sunken driveways, sidewalks, and patios with 5/8-inch ports. Call for an on-site inspection.`;

const breadcrumbs = [
  { name: 'Service Areas', path: '/service-areas/' },
  { name: `${townName}, ${state}`, path: `/service-areas/hilliard/` },
];

import { getServiceSchema } from '../../utils/schema.ts';

const schemas = [
  getServiceSchema({
    name: `Concrete Leveling and Polyjacking in ${townName}, ${state}`,
    serviceType: 'Polyurethane Foam Concrete Leveling',
    description: `Professional polyurethane foam concrete lifting for residential driveways, walkways, and patios across ${townName}, ${state}.`,
    canonicalPath: '/service-areas/hilliard/',
    areaName: townName,
    countyName: townCounty,
  }),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/service-areas/hilliard/"
  breadcrumbs={breadcrumbs}
  schemas={schemas}
>
  <div class="container" style="padding-top: 32px; padding-bottom: 32px;">
    <h1>Concrete Leveling in Hilliard, {state}</h1>
    <p class="lead">
      Restoring sunken driveways, sidewalks, patios, and garage floors across {townName}. High-density polyurethane foam lifting with small 5/8-inch ports, 15-minute cure time, and zero lawn disruption.
    </p>
  </div>

  <section class="section bg-surface" style="padding-top: 0;">
    <div class="container">
      <div class="content-grid">
        <div class="content-main">
          <h2>Geological Soil Factors Behind Concrete Sinking in Hilliard</h2>
          <p>
            Positioned in western {townCounty} within Norwich Township, Hilliard sits on terrain shaped by glacial outwash channels. The subgrade beneath Hilliard homes is characterized by localized pockets of loose sand and gravel intertwined with dense, cohesive clay strata.
          </p>
          <p>
            During central Ohio winters, repeated freeze-thaw cycles exert tremendous upward thrust on concrete flatwork. As moisture trapped in the clay stratum freezes, it expands by approximately 9 percent. When spring thaws arrive, meltwater drains through the gravel lenses, washing fine clay particles away.
          </p>
          <p>
            This wash-through leaves unsupported voids beneath concrete slabs. Throughout mature communities in Old Hilliard, Brookfield, Hampton Green, and neighborhoods surrounding Homestead Metro Park, we frequently encounter front walkways tilting inward, patio slabs dropping away from brick foundations, and driveway approach slabs sinking two to four inches below garage thresholds.
          </p>

          <h2>Hilliard Pedestrian Safety & Trip Hazard Codes</h2>
          <p>
            Both the City of Hilliard and Norwich Township maintain active pedestrian pathway standards to protect school children, cyclists, and neighborhood walkers. When a public sidewalk panel shifts vertically by more than one-quarter to one-half inch, it is cited as a trip hazard.
          </p>
          <p>
            Homeowners are legally responsible for repairing public sidewalk slabs running along their street frontage. Rather than undergoing expensive full-slab replacement that tears up front lawns and requires city permits, our polyurethane foam lifting process raises sunken panels flush in under two hours. The repaired walkway complies immediately with local pedestrian safety rules and ADA guidelines.
          </p>

          <h2>Why Hilliard Homeowners Choose Poly Foam Over Mudjacking</h2>
          <p>
            Mudjacking was once the standard method used to raise concrete, but it has significant drawbacks on Hilliard's glacial soils:
          </p>
          <ul>
            <li style="margin-bottom: 12px;">
              <strong>Overloading Loose Subgrades:</strong> Mudjacking injects a heavy slurry of soil, limestone, and water weighing 120 pounds per cubic foot. Pumping heavy mud directly onto gravel-and-clay pockets in Hilliard often triggers secondary settlement within two seasons. Poly foam weighs only 3 to 5 pounds per cubic foot.
            </li>
            <li style="margin-bottom: 12px;">
              <strong>Dime-Sized Ports:</strong> Mudjacking requires coring large 2-inch holes that leave permanent circular patches across your concrete. Our polyjacking process uses clean 5/8-inch ports that are patched with color-matched mortar and blend smoothly into the surface.
            </li>
            <li style="margin-bottom: 12px;">
              <strong>Washout Resistance:</strong> Mudjacking slurry dissolves when underground storm runoff filters through Hilliard's gravel pockets. Polyurethane foam is 100 percent closed-cell hydrophobic material that never erodes.
            </li>
          </ul>

          <h2>Typical Hilliard Concrete Leveling Applications</h2>
          <div class="index-rows">
            <div class="index-row">
              <span class="index-row-title">Driveway Approach Alignment</span>
              <p class="index-row-desc">
                Lifting sunken driveway slabs flush with garage door thresholds to eliminate tire jarring and prevent rainwater from pooling near foundation walls.
              </p>
            </div>
            <div class="index-row">
              <span class="index-row-title">Front Walkway Trip Hazard Elimination</span>
              <p class="index-row-desc">
                Raising uneven sidewalk slabs to restore a flush pedestrian path, eliminating trip hazards and HOA citations without lawn damage.
              </p>
            </div>
            <div class="index-row">
              <span class="index-row-title">Patio & Porch Stabilization</span>
              <p class="index-row-desc">
                Reversing negative slope on settled patio slabs to direct water away from basement walls and leveling sunken entrance stoops.
              </p>
            </div>
          </div>

          <h2>Neighboring Central Ohio Communities We Serve</h2>
          <p>
            In addition to Hilliard, our mobile leveling rigs provide daily dispatch across western and central Franklin County:
          </p>
          <ul>
            <li style="margin-bottom: 8px;">
              <a href="/service-areas/dublin/">Concrete Leveling in Dublin, {state}</a> for suburban driveway and sidewalk stabilization.
            </li>
            <li style="margin-bottom: 8px;">
              <a href="/service-areas/grove-city/">Concrete Leveling in Grove City, {state}</a> for residential slab leveling.
            </li>
            <li style="margin-bottom: 8px;">
              <a href="/service-areas/westerville/">Concrete Leveling in Westerville, {state}</a> for driveway and walkway repair.
            </li>
            <li style="margin-bottom: 8px;">
              <a href="/service-areas/">View All Regional Service Areas</a>.
            </li>
          </ul>

          <p style="margin-top: 24px;">
            Want to learn more about the technical process? Read our detailed engineering guide on <a href="/concrete-leveling/polyurethane-foam-lifting/">polyurethane foam concrete leveling and polyjacking</a> or review our <a href="/concrete-leveling-cost/">concrete leveling cost guide</a> for typical pricing ranges.
          </p>
        </div>

        <aside class="sidebar-box">
          <h3>Hilliard Dispatch</h3>
          <p class="text-secondary" style="font-size: 15px;">
            Serving all residential neighborhoods and commercial properties throughout {townCounty}:
          </p>
          <ul style="list-style: none; display: flex; flex-direction: column; gap: 8px; margin-bottom: 24px; font-size: 15px;">
            <li><strong>Service Area:</strong> {townName}, {state} (43026)</li>
            <li><strong>Method:</strong> Two-Part Poly Foam</li>
            <li><strong>Hole Size:</strong> 5/8-inch Dime Sized</li>
            {warrantyText && <li><strong>Warranty:</strong> {warrantyText}</li>}
            {licenseNumber && <li><strong>Contractor ID:</strong> {licenseNumber}</li>}
          </ul>
          <a href="/contact/" class="btn-primary" style="width: 100%;">
            Get Free Hilliard Quote
          </a>
          <p style="text-align: center; margin-top: 16px; margin-bottom: 0;">
            Direct phone: <a href={phoneTel} class="phone-link">{phoneDisplay}</a>
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class="section bg-neutral">
    <div class="container">
      <div class="content-grid">
        <div>
          <h2>Schedule Your Hilliard Concrete Inspection</h2>
          <p>
            Do not let an uneven sidewalk or sunken driveway continue posing liability or drainage risks. Provide your property details below and our Hilliard estimator will visit to shoot laser elevations and deliver a firm written proposal.
          </p>
          <p>
            Or reach our dispatch desk directly by calling <a href={phoneTel} class="phone-link">{phoneDisplay}</a>.
          </p>
        </div>
        <div>
          <EstimateForm formTitle={`Request a ${townName} Inspection`} />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
